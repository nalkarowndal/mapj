# 동북미식 (DONGBUK TABLE) Backend Environment Variables Template
# Copy this file to .env and fill in your actual credentials. Never commit .env!

# 1. Database Connection
# 운영/스테이징 (PostgreSQL 권장):
# DATABASE_URL=postgresql+psycopg://dongbuk_user:change_me@localhost:5432/dongbuk_table
# 로컬 개발 기본값 (미설정 시 backend_/data/dongbuk_table.db SQLite 사용):
DATABASE_URL=

# 2. Admin Bootstrap Credentials (최초 1회 관리자 테이블이 비어 있을 때만 생성됨)
ADMIN_DEFAULT_EMAIL=admin@dongbuktable.kr
ADMIN_DEFAULT_PASSWORD=change_this_strong_password_before_deploy
ADMIN_SESSION_TTL_HOURS=12
ADMIN_COOKIE_SECURE=false

# 3. Groq API Key (무료 발급: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# 4. Kakao Developers REST & JS Keys (발급: https://developers.kakao.com)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
KAKAO_JS_API_KEY=your_kakao_js_api_key_here

# 5. Server & CORS Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
