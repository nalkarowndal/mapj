# Backend Environment Variables Template
# Copy this file to .env and fill in your actual credentials.

# 1. Groq API Key (무료 발급: https://console.groq.com)
# 유효한 키가 없을 경우, 시스템은 안전하게 '검증된 지역 데이터 기반 추천 모드'로 자동 전환됩니다.
GROQ_API_KEY=your_groq_api_key_here

# 2. Kakao Developers REST API Key (발급: https://developers.kakao.com)
# 카카오 로컬 검색 API를 통해 실시간 신규 매장 정보를 검색할 때 사용됩니다.
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 3. Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
