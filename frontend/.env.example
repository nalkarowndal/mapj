# 동북미식 (DONGBUK TABLE) Frontend Environment Variables Template
# Copy to .env.local for local development. Never commit .env.local!

# Internal FastAPI Backend URL used by Next.js rewrites & SSR fetches
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Public canonical site URL for sitemap.xml, robots.txt, and OpenGraph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
