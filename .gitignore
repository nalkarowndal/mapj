# Git ignore rules for AI Local Assistant

# Environment variables
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!*.env.example
backend_/data/
settings.json
*.secret

# Node
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
backend_/__pycache__/
*.py[cod]
*$py.class
*.venv
venv/
ENV/
.pytest_cache/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
